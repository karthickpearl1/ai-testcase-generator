# Copy to .env and fill in only the provider you want to use.
# Nothing here is required: the default provider is the offline mock.

# mock | openai | azure_openai | bedrock
TESTGEN_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-06-01

# AWS Bedrock (credentials come from the standard AWS chain: env, profile, SSO, role)
AWS_REGION=eu-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Used by the generated API tests when you point them at your own environment
API_BASE_URL=http://127.0.0.1:8000
API_TOKEN=demo-token
